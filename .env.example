#----------------------------------------------------------
# Supabase Environment Variables
#----------------------------------------------------------
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_PUBLISHABLE_KEY=your_supabase_publishable_key
# local service_role — E2E fixture only, never imported from src/
SUPABASE_SECRET_KEY=your_supabase_secret_key

#----------------------------------------------------------
# Google OAuth (optional, for Supabase Auth)
#   Get these from https://console.cloud.google.com/apis/credentials
#----------------------------------------------------------
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret

#----------------------------------------------------------
# Next.js public env (Supabase local — values from `supabase start`)
#----------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
NEXT_PUBLIC_SITE_URL=http://localhost:3000

#----------------------------------------------------------
# App config
#----------------------------------------------------------
# Sample value from MoMorph TC ID-57 (ISO-8601 with +07:00 offset), not an
# invented date — replace with the real event start once it is confirmed.
NEXT_PUBLIC_EVENT_START_AT=2025-12-31T18:30:00+07:00
